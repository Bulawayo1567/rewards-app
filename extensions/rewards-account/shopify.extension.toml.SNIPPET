Replace the [[extensions.targeting]] section(s) in extensions\rewards-account\shopify.extension.toml with all three below
(keep everything else — api_version, name, handle, uid, capabilities — exactly as it is):

[[extensions.targeting]]
module = "./src/RewardsPage.jsx"
target = "customer-account.page.render"

[[extensions.targeting]]
module = "./src/OrderIndexBanner.jsx"
target = "customer-account.order-index.block.render"

[[extensions.targeting]]
module = "./src/OrderStatusBlock.jsx"
target = "customer-account.order-status.block.render"
